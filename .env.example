# Copy to .env to override defaults.
DEVICE=auto              # auto | cuda | cpu
MODEL_NAME=f5-tts
F5_MODEL=F5TTS_v1_Base
F5_NFE_STEPS=32          # lower = faster, slightly worse quality (16 is a good CPU setting)
SEED=42
SPLIT_SENTENCES=true       # synthesize sentence by sentence, joined with an explicit gap
SENTENCE_PAUSE_SECONDS=0.35  # neutral inter-sentence pause (what the pause control scales)
SAMPLE_RATE=24000
MIN_REFERENCE_SECONDS=5
MAX_REFERENCE_SECONDS=10
MAX_TEXT_CHARS=600
WHISPER_MODEL=openai/whisper-base.en
ENABLE_EVALUATION=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
